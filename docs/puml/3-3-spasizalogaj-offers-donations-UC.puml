' ==============================================================================
' 3-3-spasizalogaj-offers-donations-UC.puml
'
' Svrha:    Usmjereni vodoravni dijagram dva toka:
'           1) Tok prodajnog mjesta: plaćanje članarine kao uvjet za objavu ponude.
'           2) Tok donacija: zahtjev humanitarne organizacije i odlučivanje prodajnog mjesta.
' Zahtjevi: UC-02, UC-06 (docs/3-Obrasci-uporabe.md);
'           F-005 – F-007, F-015, F-016 (docs/2-Analiza-zahtjeva.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – ponude i donacije
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Prodajno mjesto" as Prodavac
actor "Humanitarna\norganizacija" as Org
actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>

rectangle "SpasiZalogaj" {
    ' Tok 1: Prodajno mjesto
    usecase "Plaćanje članarine" as UCClan
    usecase "UC-02 Objava ponude ili\npaketa iznenađenja" as UC02
    
    ' Tok 2: Donacije
    usecase "UC-06 Zahtjev\nza donaciju" as UC06
    usecase "Odobravanje ili\nodbijanje zahtjeva" as UCOdluka
}

actor "Prodajno mjesto" as Prodavac2

' Tok 1: Prodajno mjesto (gore)
Prodavac --> UCClan
UCClan ..> UC02 : <<precedes>>\n(uvjet za objavu)
UCClan -up-> Placanje

' Tok 2: Donacije (dolje)
Org --> UC06
UC06 ..> UCOdluka : <<precedes>>
UCOdluka <-- Prodavac2

@enduml
