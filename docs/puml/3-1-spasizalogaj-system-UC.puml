' ==============================================================================
' 3-1-spasizalogaj-system-UC.puml
'
' Svrha:    Pregledni dijagram osnovnih funkcija sustava SpasiZalogaj:
'           glavni ciljevi osnovnih aktera i vanjski sustavi (OAuth, plaćanje,
'           karta).
' Zahtjevi: UC-01 do UC-07 detaljno su opisani u docs/3-Obrasci-uporabe.md;
'           prikazane su isključivo osnovne funkcije sustava.
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – pregled osnovnih funkcija
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

' Opći akter: zajednički osnovni obrazac uporabe svih registriranih korisnika
actor "Korisnik" as Korisnik

' Primarni akteri
actor "Kupac" as Kupac
actor "Prodajno mjesto" as Prodavac
actor "Humanitarna\norganizacija" as Org
actor "Zaposlenik\nprodajnog mjesta" as Zaposlenik
actor "Administrator" as Admin

Kupac -up-|> Korisnik
Prodavac -up-|> Korisnik
Org -up-|> Korisnik

rectangle "SpasiZalogaj" {
    ' Zajedničko
    usecase "UC-01 Prijava i\nodabir uloge" as UC01

    ' Kupac
    usecase "UC-03 Pretraga na karti i\nrezervacija s plaćanjem" as UC03
    usecase "UC-05 Otkazivanje\nrezervacije" as UC05

    ' Preuzimanje (Kupac i Zaposlenik)
    usecase "UC-04 Potvrda\npreuzimanja kodom" as UC04

    ' Prodajno mjesto
    usecase "Plaćanje članarine" as UCClan
    usecase "UC-02 Objava ponude ili\npaketa iznenađenja" as UC02

    ' Donacije (Humanitarna organizacija i Prodajno mjesto)
    usecase "UC-06 Zahtjev\nza donaciju" as UC06

    ' Administrator
    usecase "UC-07 Odobravanje\nprofila organizacije" as UC07
    usecase "Određivanje cijena\nčlanarine" as UCCij
}

' Vanjski sustavi (sekundarni akteri)
actor "OAuth pružatelj\nidentiteta" as OAuth <<vanjski sustav>>
actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>
actor "Kartografska\nusluga" as Karta <<vanjski sustav>>

' Povezivanje aktera i obrazaca uporabe
Korisnik --> UC01

Kupac --> UC03
Kupac --> UC04
Kupac --> UC05

Prodavac --> UCClan
Prodavac --> UC02
Prodavac --> UC06

Zaposlenik --> UC04

Org --> UC06

Admin --> UC07
Admin --> UCCij

' Povezivanje s vanjskim servisima
UC01 --> OAuth
UC03 --> Karta
UC03 --> Placanje
UC05 --> Placanje
UCClan --> Placanje

@enduml
