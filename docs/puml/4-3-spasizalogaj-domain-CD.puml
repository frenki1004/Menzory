' Reprezentativni prikaz implementacije na mainu nakon PR #32.
' Moduli su TypeScript funkcije, objekti su Prisma modeli.
@startuml
title SpasiZalogaj – obrada rezervacije (M1)
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

class "Rezervacijski servis" as Service <<modul>> {
  +createReservation()
  +confirmPickup()
  +getUserReservations()
}

class "Pravila rezervacije" as Rules <<modul>> {
  +isValidReservationQuantity()
  +checkOfferAvailability()
  +calculateTotalAmount()
  +isCancellationAllowed()
}

class "Kod za preuzimanje" as Code <<modul>> {
  +generatePickupCode()
  +hashPickupCode()
  +verifyPickupCode()
}

class "Prisma klijent" as Prisma <<pristup bazi>> {
  +$transaction()
}

class "Rezervacija" as Reservation <<Prisma model>> {
  status
  totalAmount
  pickupCodeHash
}

class "Stavka rezervacije" as Item <<Prisma model>> {
  quantity
  unitPrice
}

class "Ponuda" as Offer <<Prisma model>> {
  availableQuantity
  price
}

Service ..> Rules : provjere i iznos
Service ..> Code : generiranje i sažimanje
Service --> Prisma : upiti i transakcija
Prisma ..> Reservation : pohrana
Prisma ..> Offer : količina
Reservation "1" *-- "0..*" Item
Item "*" --> "1" Offer
@enduml
