' ==============================================================================
' 3-1-spasizalogaj-system-UC.puml
'
' Svrha:    Pregledni dijagram osnovnih funkcija sustava SpasiZalogaj:
'           sadrži isključivo 7 ključnih obrazaca uporabe (UC-01 do UC-07)
'           i njihovu izravnu vezu s akterima, bez preklapanja linija.
' Zahtjevi: UC-01 do UC-07 (docs/3-Obrasci-uporabe.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – pregledni dijagram obrazaca uporabe
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Korisnik" as Korisnik
actor "Prodajno mjesto" as Prodavac
actor "Kupac" as Kupac
actor "Zaposlenik\nprodajnog mjesta" as Zaposlenik
actor "Humanitarna\norganizacija" as Org
actor "Administrator" as Admin

Kupac -up-|> Korisnik
Prodavac -up-|> Korisnik
Org -up-|> Korisnik

rectangle "SpasiZalogaj" {
    usecase "UC-01 Prijava i\nodabir uloge" as UC01
    usecase "UC-02 Objava ponude\nili paketa iznenađenja" as UC02
    usecase "UC-03 Pretraga na karti\ni rezervacija s plaćanjem" as UC03
    usecase "UC-04 Potvrda\npreuzimanja kodom" as UC04
    usecase "UC-05 Otkazivanje\nrezervacije" as UC05
    usecase "UC-06 Zahtjev\nza donaciju" as UC06
    usecase "UC-07 Odobravanje\nprofila organizacije" as UC07
}

actor "OAuth pružatelj\nidentiteta" as OAuth <<vanjski sustav>>
actor "Kartografska\nusluga" as Karta <<vanjski sustav>>
actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>

Korisnik --> UC01
UC01 --> OAuth

Prodavac --> UC02

Kupac --> UC03
Kupac --> UC04
Kupac --> UC05

UC03 --> Karta
UC03 --> Placanje
UC05 --> Placanje

Zaposlenik --> UC04

Org --> UC06
Prodavac --> UC06

Admin --> UC07
@enduml
