' ==============================================================================
' 3-2-spasizalogaj-reservation-UC.puml
'
' Svrha:    Usmjereni dijagram obrazaca uporabe za rezervaciju i preuzimanje:
'           pretraga, rezervacija s plaćanjem, otkazivanje, potvrda preuzimanja
'           kodom te ocjenjivanje prodajnog mjesta.
' Zahtjevi: UC-03, UC-04, UC-05 (docs/3-Obrasci-uporabe.md);
'           F-009 – F-014 (docs/2-Analiza-zahtjeva.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – rezervacija i preuzimanje
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Kupac" as Kupac
actor "Zaposlenik\nprodajnog mjesta" as Zaposlenik
actor "Prodajno mjesto" as Prodavac

rectangle "SpasiZalogaj" {
    usecase "UC-03 Pretraga na karti i\nrezervacija s plaćanjem" as UC03
    usecase "Pretraga i filtriranje\nponuda" as UCPretraga
    usecase "Prikaz udaljenosti\nod korisnika" as UCUdaljenost
    usecase "Plaćanje rezervacije" as UCPlacanje
    usecase "Izdavanje koda\nza preuzimanje" as UCKod

    usecase "UC-05 Otkazivanje\nrezervacije" as UC05
    usecase "Povrat novca" as UCPovrat

    usecase "Pregled rezervacija" as UCPregled

    usecase "UC-04 Potvrda\npreuzimanja kodom" as UC04

    usecase "Ocjena i komentar" as UCOcjena
    usecase "Odgovor na komentar" as UCOdgovor
}

actor "Kartografska\nusluga" as Karta <<vanjski sustav>>
actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>

Kupac --> UC03
Kupac --> UC05
Kupac --> UCPregled
Kupac --> UCOcjena

Zaposlenik --> UC04

Prodavac --> UCPregled
Prodavac --> UCOdgovor

UC03 ..> UCPretraga : <<include>>
UC03 ..> UCPlacanje : <<include>>
UC03 ..> UCKod : <<include>>
UCUdaljenost ..> UCPretraga : <<extend>>\n(kupac dopušta lokaciju)
UC05 ..> UCPovrat : <<include>>

UCPretraga --> Karta
UCUdaljenost --> Karta
UCPlacanje --> Placanje
UCPovrat --> Placanje
@enduml
