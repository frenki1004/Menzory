# ========================================================
# SpasiZalogaj (Tim Menzory) - Environment Variables
# ========================================================

# Neon PostgreSQL connection string (ADR-02)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret (generate with `npx auth secret` or `openssl rand -base64 33`)
AUTH_SECRET="your-generated-auth-secret-min-32-chars"

# Google OAuth 2.0 / OIDC credentials (ADR-03)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Public App URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
