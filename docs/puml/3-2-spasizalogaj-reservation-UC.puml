' ==============================================================================
' 3-2-spasizalogaj-reservation-UC.puml
'
' Svrha:    Usmjereni vodoravni dijagram toka kupca: pretraga na karti,
'           rezervacija s plaćanjem, potvrda preuzimanja kodom (ili otkazivanje)
'           te opcionalno ocjenjivanje prodajnog mjesta.
' Zahtjevi: UC-03, UC-04, UC-05 (docs/3-Obrasci-uporabe.md);
'           F-009 – F-012, F-014 (docs/2-Analiza-zahtjeva.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – rezervacija i preuzimanje
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Kupac" as Kupac
actor "Kartografska\nusluga" as Karta <<vanjski sustav>>

rectangle "SpasiZalogaj" {
    usecase "Pretraga ponuda\nna karti" as UCPretraga
    usecase "UC-03 Rezervacija\ns plaćanjem" as UC03
    usecase "UC-04 Potvrda\npreuzimanja kodom" as UC04
    usecase "UC-05 Otkazivanje\nrezervacije" as UC05
    usecase "Ocjena prodajnog\nmjesta" as UCOcjena
}

actor "Zaposlenik\nprodajnog mjesta" as Zaposlenik
actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>

' Vodoravni tok radnji kupca
Kupac --> UCPretraga
UCPretraga ..> UC03 : <<include>>
UCPretraga --> Karta

' Grananje nakon rezervacije
UC03 <.. UC04 : <<extend>>
UC03 <.. UC05 : <<extend>>\n(rok ≥ 1 h)
UC04 <.. UCOcjena : <<extend>>\n(opcionalno)

' Interakcija s vanjskim servisima i zaposlenikom
Zaposlenik --> UC04
UC03 --> Placanje
Placanje <-- UC05

' Poravnanje radi kraćih i simetričnih linija
UC04 -[hidden]up-> Zaposlenik
UC05 -[hidden]down-> Placanje

@enduml
