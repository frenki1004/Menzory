' ==============================================================================
' 3-1-spasizalogaj-system-UC.puml
'
' Svrha:    Pregledni dijagram osnovnih funkcija sustava SpasiZalogaj:
'           glavni obrasci uporabe svakog aktera i vanjski sustavi s kojima
'           sustav surađuje. Razrada pojedinih područja nalazi se na
'           dijagramima 3-2 (rezervacija i preuzimanje) i 3-3 (ponude).
' Zahtjevi: UC-01 – UC-08, UC-10, UC-12, UC-16 (docs/3-Obrasci-uporabe.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – pregledni dijagram obrazaca uporabe
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Korisnik" as Korisnik
actor "Prodajno mjesto" as Prodavac
actor "Kupac" as Kupac
actor "Zaposlenik\nprodajnog mjesta" as Zaposlenik
actor "Humanitarna\norganizacija" as Org
actor "Administrator" as Admin

Kupac -up-|> Korisnik
Prodavac -up-|> Korisnik
Org -up-|> Korisnik

' Prazni redovi u nazivu ostavljaju mjesta na vrhu okvira da veza
' prodajnog mjesta prema UC-12 ostane unutar pravokutnika.
rectangle "SpasiZalogaj\n\n" {
    usecase "UC-01 Prijava i\nodabir uloge" as UC01
    usecase "UC-02 Objava\nponude" as UC02
    usecase "UC-12 Plaćanje\nčlanarine" as UC12
    usecase "UC-16 Odlučivanje o\nzahtjevu za donaciju" as UC16
    usecase "UC-06 Zahtjev\nza donaciju" as UC06
    usecase "UC-08 Pretraga\nponuda na karti" as UC08
    usecase "UC-03 Rezervacija\nponude" as UC03
    usecase "UC-10 Pregled\nrezervacija" as UC10
    usecase "UC-05 Otkazivanje\nrezervacije" as UC05
    usecase "UC-04 Potvrda\npreuzimanja kodom" as UC04
    usecase "UC-07 Odobravanje\nprofila organizacije" as UC07
}

actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>
actor "Kartografska\nusluga" as Karta <<vanjski sustav>>
actor "OAuth pružatelj\nidentiteta" as OAuth <<vanjski sustav>>

' Prijava
Korisnik --> UC01
UC01 --> OAuth

' Prodajno mjesto
Prodavac --> UC02
Prodavac --> UC12
UC12 --> Placanje
Prodavac --> UC16

' Humanitarna organizacija
Org --> UC06

' Kupac
Kupac --> UC08
UC08 --> Karta
Kupac --> UC03
UC03 --> Placanje
Kupac --> UC10
UC10 <.. UC05 : <<extend>>\n(do isteka > 1 h)
UC05 --> Placanje
Zaposlenik --> UC04

' Administrator
Admin --> UC07

' Poravnanje (skrivene veze samo određuju raspored, nisu dio modela):
' plaćanje članarine uz servis za plaćanje, vanjski akteri desno od
' sustava, administrator na dnu.
UC16 -[hidden]-> UC12
UC05 -[hidden]-> Karta
UC05 -[hidden]-> OAuth
UC10 -[hidden]-> Placanje
Placanje -[hidden]down- Karta
Karta -[hidden]down- OAuth
Zaposlenik -[hidden]right- Admin

@enduml
