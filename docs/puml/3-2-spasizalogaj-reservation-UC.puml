' ==============================================================================
' 3-2-spasizalogaj-reservation-UC.puml
'
' Svrha:    Obrasci uporabe kupca: pretraga ponuda na karti, rezervacija s
'           obveznim plaćanjem, pregled rezervacija iz kojeg kupac može
'           otkazati rezervaciju ili ocijeniti prodajno mjesto te potvrda
'           preuzimanja kodom koju provodi zaposlenik prodajnog mjesta.
' Zahtjevi: UC-03, UC-04, UC-05 (docs/3-Obrasci-uporabe.md);
'           F-009 – F-014 (docs/2-Analiza-zahtjeva.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – rezervacija i preuzimanje
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Kupac" as Kupac
actor "Zaposlenik\nprodajnog mjesta" as Zaposlenik

rectangle "SpasiZalogaj" {
    ' Pretraga (UC-03, koraci 1–3)
    usecase "Pretraga ponuda\nna karti" as UCPretraga
    usecase "Filtriranje ponuda" as UCFilter

    ' Rezervacija i plaćanje (UC-03, koraci 4–8)
    usecase "UC-03 Rezervacija\nponude" as UC03
    usecase "Plaćanje\nrezervacije" as UCPlati

    ' Nakon rezervacije
    usecase "Pregled\nrezervacija" as UCPregled
    usecase "UC-05 Otkazivanje\nrezervacije" as UC05
    usecase "Povrat novca" as UCPovrat
    usecase "Ocjena prodajnog\nmjesta" as UCOcjena

    usecase "UC-04 Potvrda\npreuzimanja kodom" as UC04
}

actor "Kartografska\nusluga" as Karta <<vanjski sustav>>
actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>

' Pretraga
Kupac --> UCPretraga
UCPretraga <.. UCFilter : <<extend>>\n(kupac postavi filtre)
UCPretraga --> Karta

' Rezervacija uvijek uključuje plaćanje
Kupac --> UC03
UC03 ..> UCPlati : <<include>>
UCPlati --> Placanje

' Pregled rezervacija: otkazivanje ili ocjena
Kupac --> UCPregled
UCPregled <.. UC05 : <<extend>>\n(do isteka > 1 h)
UCPregled <.. UCOcjena : <<extend>>\n(rezervacija preuzeta)
UC05 ..> UCPovrat : <<include>>
UCPovrat --> Placanje

' Preuzimanje
Kupac --> UC04
Zaposlenik --> UC04

' Poravnanje: kartografska usluga u desnom stupcu uz servis za plaćanje
UCPovrat -[hidden]-> Karta

@enduml
