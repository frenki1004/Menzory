' ==============================================================================
' 3-2-spasizalogaj-reservation-UC.puml
'
' Svrha:    Obrasci uporabe kupca: pretraga ponuda na karti s filtriranjem,
'           rezervacija s plaćanjem, pregled rezervacija iz kojeg kupac može
'           otkazati rezervaciju ili ocijeniti prodajno mjesto te potvrda
'           preuzimanja kodom koju provodi zaposlenik prodajnog mjesta.
' Zahtjevi: UC-03, UC-04, UC-05, UC-08 – UC-11 (docs/3-Obrasci-uporabe.md);
'           F-009 – F-014 (docs/2-Analiza-zahtjeva.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – rezervacija i preuzimanje
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Kupac" as Kupac
actor "Zaposlenik\nprodajnog mjesta" as Zaposlenik

' Prazni redovi u nazivu ostavljaju mjesta na vrhu okvira da veza
' UC-08 prema kartografskoj usluzi ne prelazi preko naslova i ruba.
rectangle "SpasiZalogaj\n\n" {
    usecase "UC-08 Pretraga\nponuda na karti" as UC08
    usecase "UC-09 Filtriranje\nponuda" as UC09
    usecase "UC-03 Rezervacija\nponude" as UC03
    usecase "UC-10 Pregled\nrezervacija" as UC10
    usecase "UC-05 Otkazivanje\nrezervacije" as UC05
    usecase "UC-11 Ocjena\nprodajnog mjesta" as UC11
    usecase "UC-04 Potvrda\npreuzimanja kodom" as UC04
}

actor "Kartografska\nusluga" as Karta <<vanjski sustav>>
actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>

' Pretraga
Kupac --> UC08
UC08 <.. UC09 : <<extend>>\n(kupac postavi filtre)
UC08 --> Karta

' Rezervacija s plaćanjem
Kupac --> UC03
UC03 --> Placanje

' Pregled rezervacija: otkazivanje ili ocjena
Kupac --> UC10
UC10 <.. UC05 : <<extend>>\n(do isteka > 1 h)
UC10 <.. UC11 : <<extend>>\n(rezervacija preuzeta)
UC05 --> Placanje

' Preuzimanje: kod skenira zaposlenik; kupac ga samo pokazuje (dobio ga je u UC-03)
Zaposlenik --> UC04
' Poravnanje (skrivena veza samo određuje raspored): kartografska usluga desno
UC09 -[hidden]-> Karta

@enduml
