' ==============================================================================
' 3-3-spasizalogaj-offers-donations-UC.puml
'
' Svrha:    Obrasci uporabe prodajnog mjesta vezani uz ponude: plaćanje
'           članarine, objava ponude (proizvod, paket iznenađenja ili
'           donacija), upravljanje ponudama i odlučivanje o zahtjevima
'           za donaciju. Aktivna članarina preduvjet je za objavu ponude
'           (UC-02, Preduvjeti), pa se na dijagramu ne prikazuje vezom.
' Zahtjevi: UC-02, UC-06 (docs/3-Obrasci-uporabe.md);
'           F-005 – F-008, F-016 (docs/2-Analiza-zahtjeva.md).
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml
title SpasiZalogaj – ponude i donacije
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<vanjski sustav>> #FFF3CD
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #212529
}
skinparam rectangle {
    BorderColor #6C757D
}

actor "Prodajno mjesto" as Prodavac

rectangle "SpasiZalogaj" {
    usecase "Plaćanje članarine" as UCClan
    usecase "Plaćanje preko\nvanjskog servisa" as UCPlati

    usecase "UC-02 Objava\nponude" as UC02
    usecase "Objava paketa\niznenađenja" as UCPaket
    usecase "Objava donacije" as UCDonacija

    usecase "Upravljanje\nponudama" as UCUpravljanje

    usecase "Odlučivanje o zahtjevu\nza donaciju" as UCOdluka
}

actor "Servis za\nplaćanje" as Placanje <<vanjski sustav>>

' Članarina
Prodavac --> UCClan
UCClan ..> UCPlati : <<include>>
UCPlati --> Placanje

' Objava ponude i njezine varijante
Prodavac --> UC02
UC02 <.. UCPaket : <<extend>>\n(odabran paket)
UC02 <.. UCDonacija : <<extend>>\n(proizvod se donira)

' Uređivanje i povlačenje objavljenih ponuda
Prodavac --> UCUpravljanje

' Prodajno mjesto reagira na zahtjev za doniranu ponudu
Prodavac --> UCOdluka

@enduml
